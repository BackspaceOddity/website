// CascadeSankey — full Cascade Navigation System v5.1 visualization.
// Renders three Block swimlanes (Audience / Product / Growth Engine) with
// their sub-question columns. Real hypotheses from the initiative override
// matching slots; remaining slots stay as mock cards from the methodology.
//
// Schema lives in cascade-stages.jsx (window.CascadeStagesSchema).

function CascadeSankey({ cascade, nodes, onNav, onExpand, embedded }) {
  const { BLOCKS, SLOTS, LINKS } = window.CascadeStagesSchema || { BLOCKS: [], SLOTS: [], LINKS: [] };
  const [selectedId, setSelectedId] = React.useState(null);
  const [detailsOpen, setDetailsOpen] = React.useState(false);
  const panRef = React.useRef(null);
  const dragRef = React.useRef(null);
  const [isPanning, setIsPanning] = React.useState(false);

  if (!cascade) return null;

  // ---- Resolve real hypotheses from initiative frontmatter ----
  const hypRefs = Array.isArray(cascade.fm.hypotheses) ? cascade.fm.hypotheses : [];
  const realHyps = {};
  hypRefs.forEach(ref => {
    const id = String(ref).replace(/^\[\[([^\]|]+).*\]\]$/, '$1').replace(/^.*\//, '').trim();
    const n = nodes && nodes[id];
    if (n) realHyps[id] = n;
  });

  // ---- Build resolved cards: each slot may be overridden by a real node ----
  const cards = SLOTS.map(slot => {
    const real = slot.realId ? realHyps[slot.realId] : null;
    if (real) {
      return {
        slotId: slot.id,
        col: slot.col,
        nodeId: real.id,
        title: window.titleOf ? window.titleOf(real) : real.title,
        status: String(real.fm.status || slot.status || 'pending').toLowerCase(),
        confidence: typeof real.fm.confidence === 'number' ? real.fm.confidence : (slot.confidence || 0),
        opportunity: Number(real.fm.risk_score) || slot.opportunity || 5,
        cep: real.fm.category_entry_point || slot.cep,
        owner: real.fm.owner,
        isReal: true,
      };
    }
    return {
      slotId: slot.id,
      col: slot.col,
      nodeId: null,
      title: slot.title,
      status: slot.status || 'pending',
      confidence: slot.confidence || 0,
      opportunity: slot.opportunity || 5,
      cep: slot.cep,
      owner: null,
      isReal: false,
    };
  });

  const cardBySlot = {};
  cards.forEach(c => { cardBySlot[c.slotId] = c; });

  // Stage index: flatten BLOCKS columns into a single 0..N order. Used by
  // connectors to taper line thickness — early cascade columns (JTBD/CEPs)
  // carry more weight than late columns (CAC/Retention/LTV).
  const stageByCol = {};
  let _idx = 0;
  BLOCKS.forEach(b => b.columns.forEach(c => { stageByCol[c.id] = _idx++; }));
  const maxStage = Math.max(0, _idx - 1);

  // ---- Group cards by column id for layout ----
  const cardsByCol = {};
  cards.forEach(c => {
    if (!cardsByCol[c.col]) cardsByCol[c.col] = [];
    cardsByCol[c.col].push(c);
  });

  // ---- Selection-driven highlight set: BFS along LINKS in both directions ----
  const highlightSet = new Set();
  if (selectedId) {
    highlightSet.add(selectedId);
    const adj = {};
    LINKS.forEach(([a, b]) => {
      if (!adj[a]) adj[a] = []; adj[a].push(b);
      if (!adj[b]) adj[b] = []; adj[b].push(a);
    });
    const queue = [selectedId];
    while (queue.length) {
      const cur = queue.shift();
      (adj[cur] || []).forEach(n => {
        if (!highlightSet.has(n)) { highlightSet.add(n); queue.push(n); }
      });
    }
  }

  // ---- Summary numbers ----
  const realCards = cards.filter(c => c.isReal);
  const active = realCards.filter(c => c.status === 'testing' || c.status === 'pending');
  const avgConf = realCards.length
    ? Math.round((realCards.reduce((s, c) => s + (c.confidence || 0), 0) / realCards.length) * 100)
    : 0;

  // ---- Pan-to-drag for the wide canvas ----
  const onPanDown = (e) => {
    if (e.target.closest('.csb-card, button, a')) return;
    const el = panRef.current; if (!el) return;
    dragRef.current = { x: e.clientX, y: e.clientY, sl: el.scrollLeft, st: el.scrollTop };
    setIsPanning(true);
  };
  const onPanMove = (e) => {
    if (!dragRef.current) return;
    const el = panRef.current; if (!el) return;
    el.scrollLeft = dragRef.current.sl - (e.clientX - dragRef.current.x);
    el.scrollTop = dragRef.current.st - (e.clientY - dragRef.current.y);
  };
  const onPanUp = () => { dragRef.current = null; setIsPanning(false); };

  const onCardClick = (card, e) => {
    e.stopPropagation();
    if (card.nodeId && (e.metaKey || e.ctrlKey)) { onNav(card.nodeId); return; }
    if (selectedId === card.slotId) { setSelectedId(null); setDetailsOpen(false); }
    else { setSelectedId(card.slotId); setDetailsOpen(false); }
  };
  const onBackgroundClick = () => { if (selectedId) { setSelectedId(null); setDetailsOpen(false); } };

  // ---- Status glyph ----
  const StatusGlyph = ({ status }) => {
    if (status === 'confirmed' || status === 'validated') {
      return <span className="csb-glyph csb-glyph-ok"><svg width="11" height="11" viewBox="0 0 14 14" fill="none"><path d="M3 7.3 L6 10 L11 4" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/></svg></span>;
    }
    if (status === 'denied' || status === 'rejected') {
      return <span className="csb-glyph csb-glyph-x"><svg width="11" height="11" viewBox="0 0 14 14" fill="none"><path d="M3.5 3.5 L10.5 10.5 M10.5 3.5 L3.5 10.5" stroke="currentColor" strokeWidth="2" strokeLinecap="round"/></svg></span>;
    }
    if (status === 'testing') return <span className="csb-glyph csb-glyph-test"><span className="csb-pulse-dot" /></span>;
    return <span className="csb-glyph csb-glyph-pending"><span className="csb-dot-static" /></span>;
  };

  return (
    <section className={'cascade-sankey-block cascade-stages' + (selectedId ? ' has-selection' : '')} onClick={onBackgroundClick}>
      <header className="csb-head">
        <div className="csb-head-main">
          <h2 className="csb-title">{window.titleOf ? window.titleOf(cascade) : cascade.title}</h2>
          <span className="csb-sub">
            cascade-hypotheses v5.1 · <a className="csb-link" onClick={(e) => { e.preventDefault(); e.stopPropagation(); onNav(cascade.id); }}>{cascade.id}</a>
          </span>
        </div>
        {onExpand && (
          <button className="csb-expand-btn" onClick={(e) => { e.stopPropagation(); onExpand(); }} title="Open as full page">
            <span>Expand</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M7 1 L11 1 L11 5" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/>
              <path d="M5 11 L1 11 L1 7" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/>
              <path d="M11 1 L6.5 5.5 M1 11 L5.5 6.5" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round"/>
            </svg>
          </button>
        )}
      </header>

      <div
        ref={panRef}
        className={'csb-stages-pan' + (isPanning ? ' is-panning' : '')}
        onMouseDown={onPanDown}
        onMouseMove={onPanMove}
        onMouseUp={onPanUp}
        onMouseLeave={onPanUp}
      >
        <div className="csb-stages-canvas">
          {/* Connector layer rendered first so cards sit on top */}
          <window.CascadeConnectors cards={cards} blocks={BLOCKS} links={LINKS} highlightSet={highlightSet} selectedId={selectedId} stageByCol={stageByCol} maxStage={maxStage} />

          {/* Block swimlanes */}
          <div className="csb-stages-blocks">
            {BLOCKS.map((block, bi) => (
              <div key={block.id} className={'csb-block csb-block-' + block.id}>
                <div className="csb-block-head">
                  <div className="csb-block-label">{block.label}</div>
                  <div className="csb-block-title">{block.title}</div>
                  <div className="csb-block-q">{block.question}</div>
                </div>
                <div className="csb-block-cols">
                  {block.columns.map(col => (
                    <div key={col.id} className="csb-stage-col" data-col={col.id}>
                      <div className="csb-col-head">
                        <span className="csb-col-pill">{col.label}</span>
                        <span className="csb-col-full">{col.full}</span>
                        <span className="csb-col-hint">{col.hint}</span>
                      </div>
                      <div className="csb-col-cards">
                        {(cardsByCol[col.id] || []).map(card => {
                          const dim = selectedId && !highlightSet.has(card.slotId);
                          const sel = card.slotId === selectedId;
                          const conf = Math.round((card.confidence || 0) * 100);
                          return (
                            <article
                              key={card.slotId}
                              data-slot-id={card.slotId}
                              className={
                                'csb-card csb-status-' + card.status +
                                (sel ? ' is-selected' : '') +
                                (dim ? ' is-dim' : '') +
                                (card.isReal ? ' is-real' : ' is-mock')
                              }
                              onClick={(e) => onCardClick(card, e)}
                            >
                              <div className="csb-card-row">
                                <StatusGlyph status={card.status} />
                                <span className={'csb-status-pill ' + card.status}>{card.status}</span>
                                {!card.isReal && <span className="csb-mock-pill" title="Mock — not yet formulated">mock</span>}
                              </div>
                              <div className="csb-card-title">{card.title}</div>
                              <div className="csb-conf">
                                <div className="csb-conf-bar">
                                  <div className={'csb-conf-fill ' + card.status} style={{ width: conf + '%' }} />
                                </div>
                                <span className="csb-conf-num">{conf}%</span>
                              </div>
                              {sel && (
                                <div className="csb-card-foot" onClick={(e) => e.stopPropagation()}>
                                  {card.isReal && (
                                    <button
                                      className={'csb-details-toggle' + (detailsOpen ? ' is-open' : '')}
                                      onClick={(e) => { e.stopPropagation(); setDetailsOpen(v => !v); }}
                                      aria-expanded={detailsOpen}
                                    >
                                      <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true" className="csb-chevron">
                                        <path d="M2.5 1.5 L5.5 4 L2.5 6.5" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/>
                                      </svg>
                                      <span>SHOW DETAILS</span>
                                    </button>
                                  )}
                                  <span className="csb-card-foot-meta">
                                    Conf <strong>{Math.round((card.confidence || 0) * 10)}</strong> ×
                                    Opp <strong>{card.opportunity}</strong> =
                                    <strong> {Math.round((card.confidence || 0) * 10) * card.opportunity}</strong>
                                  </span>
                                  {card.nodeId && (
                                    <button
                                      className="csb-card-fullwidth"
                                      onClick={(e) => { e.stopPropagation(); onNav(card.nodeId); }}
                                      title="Open full page"
                                      aria-label="Open full page"
                                    >
                                      <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                                        <path d="M7.5 1 L12 1 L12 5.5" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/>
                                        <path d="M5.5 12 L1 12 L1 7.5" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/>
                                        <path d="M12 1 L7 6 M1 12 L6 7" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round"/>
                                      </svg>
                                    </button>
                                  )}
                                </div>
                              )}
                              {sel && detailsOpen && card.isReal && (() => {
                                const node = nodes && card.nodeId ? nodes[card.nodeId] : null;
                                if (!node) return null;
                                // Upstream: cards in highlightSet linked TO this slot via LINKS
                                const upstream = LINKS
                                  .filter(([a, b]) => b === card.slotId)
                                  .map(([a]) => cardBySlot[a])
                                  .filter(Boolean);
                                // Downstream evidence: from frontmatter evidence_for
                                const evRefs = Array.isArray(node.fm.evidence_for) ? node.fm.evidence_for : [];
                                const evNodes = evRefs.map(r => {
                                  const id = String(r).replace(/^\[\[([^\]|]+).*\]\]$/, '$1').replace(/^.*\//, '').trim();
                                  return nodes && nodes[id] ? nodes[id] : null;
                                }).filter(Boolean);
                                return (
                                  <div className="csb-drill-body" onClick={(e) => e.stopPropagation()}>
                                    <div className="csb-drill-meta">
                                      <span className="csb-drill-label">author</span>
                                      <span className="csb-drill-value">{node.fm.author || node.fm.owner || '—'}</span>
                                      <span className="csb-drill-sep">·</span>
                                      <span className="csb-drill-label">owner</span>
                                      <span className="csb-drill-value">{node.fm.owner || node.fm.author || '—'}</span>
                                      {card.cep && (<>
                                        <span className="csb-drill-sep">·</span>
                                        <span className="csb-drill-label">CEP</span>
                                        <span className="csb-drill-value">{card.cep}</span>
                                      </>)}
                                    </div>
                                    {upstream.length > 0 && (
                                      <div className="csb-drill-cascade">
                                        <div className="csb-drill-head">↑ upstream</div>
                                        {upstream.map(u => (
                                          <div
                                            key={u.slotId}
                                            className="csb-drill-chip"
                                            onClick={(e) => { e.stopPropagation(); setSelectedId(u.slotId); setDetailsOpen(false); }}
                                          >
                                            <span className={'csb-mini-dot ' + u.status} />
                                            <span className="csb-drill-chip-title">{u.title}</span>
                                          </div>
                                        ))}
                                      </div>
                                    )}
                                    <div className="csb-drill-cascade">
                                      <div className="csb-drill-head">↓ downstream · evidence</div>
                                      {evNodes.length === 0 ? (
                                        <div className="csb-drill-empty">no evidence linked yet</div>
                                      ) : (
                                        evNodes.map(ev => (
                                          <div
                                            key={ev.id}
                                            className="csb-drill-chip"
                                            onClick={(e) => { e.stopPropagation(); onNav(ev.id); }}
                                          >
                                            <span className="csb-mini-dot" style={{ background: `var(--type-${ev.type}, var(--text-muted))` }} />
                                            <span className="csb-drill-chip-title">{window.titleOf ? window.titleOf(ev) : ev.title}</span>
                                            <span className="csb-drill-chip-type">{ev.type}</span>
                                          </div>
                                        ))
                                      )}
                                    </div>
                                  </div>
                                );
                              })()}
                            </article>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <footer className="csb-foot">
        <span className="csb-foot-stat"><strong>{realCards.length}/{cards.length}</strong> hypotheses formulated</span>
        <span className="csb-dot-sep">·</span>
        <span className="csb-foot-stat"><strong>{active.length}</strong> active in current sprint</span>
        <span className="csb-dot-sep">·</span>
        <span className="csb-foot-stat">avg conf <strong>{avgConf}%</strong></span>
        <span className="csb-dot-sep">·</span>
        <span className="csb-foot-stat">next IC review <strong>Mon</strong></span>
        <span className="csb-foot-spacer" />
        <span className="csb-foot-hint">drag to pan · click any card to trace cascade · ⌘-click to open</span>
      </footer>
    </section>
  );
}

Object.assign(window, { CascadeSankey });
